{
    "version": "2.0.0",
    "options": {
        "cwd": "${workspaceFolder}",
        "shell": {
            "executable": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-Command"
            ]
        }
    },
    "tasks": [
        {
            "label": "build active file (MSVC)",
            "type": "shell",
            "command": "& '${workspaceFolder}\\.vscode\\build.bat' '${file}' '${fileDirname}\\${fileBasenameNoExtension}.exe'",
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            }
        },
        {
            "label": "build + run active file (MSVC)",
            "type": "shell",
            "command": "& '${workspaceFolder}\\.vscode\\build.bat' '${file}' '${fileDirname}\\${fileBasenameNoExtension}.exe' run",
            "problemMatcher": [
                "$msCompile"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            }
        }
    ]
}